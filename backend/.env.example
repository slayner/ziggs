# Banco central Postgres
DATABASE_URL=postgresql+psycopg://ziggs:ziggs@localhost:5432/ziggs

# Discord OAuth (login SÓ por Discord)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback
DISCORD_SCOPES=identify guilds email

# Host que deve receber docs.html quando o backend também serve o subdomínio.
# Vazio em desenvolvimento; em produção, ex.: docs.example.com
DOCS_HOST=

# Sessão do site (troque em produção)
SECRET_KEY=dev-only-change-me

# Bot-v2 → backend: bearer secret compartilhado. O bot nunca toca no banco;
# todas as mutações vão por /bot/* com header Authorization: Bearer $BOT_API_SECRET.
# Gere um secret forte (ex: openssl rand -hex 32) e use o mesmo valor no .env do bot-v2.
BOT_API_SECRET=

# Token do bot-v2 (Discord Developer Portal → Bot → Token). Privilegiado:
# precisa de Server Members Intent + Message Content Intent + (agora) Voice States.
DISCORD_BOT_TOKEN=

ENVIRONMENT=development

# Kill-switch dos fetchers de background (battle/player/price trackers,
# profile_warmer, claim/registration checker, weapon_stats, snapshots).
# =true  -> o lifespan NÃO sobe nenhuma task de polling; as rotas da UI
#           seguem funcionando (request externo só sob demanda, ao clicar).
#           Use pra rodar o servidor em dado móvel limitado sem sugar a rede.
# =false -> comportamento normal (default).
DISABLE_BACKGROUND_FETCHERS=false
