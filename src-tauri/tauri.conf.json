{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Ziggs Companion",
    "version":  "0.2.15",
    "identifier":  "xyz.ziggs.companion",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://localhost:1420",
                  "beforeDevCommand":  "npm run dev",
                  "beforeBuildCommand":  "npm run build"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "Ziggs Companion",
                                    "width":  1024,
                                    "height":  768,
                                    "minWidth":  1024,
                                    "minHeight":  768,
                                    "maxWidth":  1024,
                                    "maxHeight":  768,
                                    "resizable":  false,
                                    "maximizable":  false,
                                    "fullscreen":  false,
                                    "visible":  false,
                                    "decorations":  false,
                                    "zoomHotkeysEnabled": false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "createUpdaterArtifacts":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/icon.ico",
                                "icons/icon.png"
                            ],
                   "resources":  [
                                      "resources/WinDivert.dll",
                                     "resources/WinDivert64.sys"
                                 ],
                   "category":  "Utility",
                   "shortDescription":  "Ziggs Companion",
                    "longDescription":  "Damage Meter and Lootlog for Albion Online.",
                   "windows":  {
                                   "nsis":  {
                                                "installerHooks":  "nsis/installer-hooks.nsh",
                                                "languages":  [
                                                                  "English",
                                                                  "Portuguese",
                                                                  "Spanish"
                                                              ],
                                                "displayLanguageSelector":  false
                                            }
                               }
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdENzJCMkI5MDc4MTVGRDkKUldUWlg0RUh1Ykp5ZmZQQU03VE5QeXV5M0I1WnhqRnFEdUwvejBTSCttM0djYmN0VzNIR1p2c0cK",
                                    "endpoints":  [
                                                      "https://ziggs.xyz/companion/latest.json"
                                                  ],
                                    "windows":  {
                                                    "installMode":  "quiet"
                                                }
                                }
                }
}