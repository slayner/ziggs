# Bot-v2 — proxy HTTP do site (fonte da verdade). O bot nunca toca no banco.

# Token do Discord (Developer Portal → Bot → Token).
# Intents privilegiadas exigidas: Server Members, Message Content, Voice States.
DISCORD_TOKEN=

# URL do backend (sem barra final) — o bot chama a API aqui. Em dev: http://localhost:8000
BOT_SITE_URL=http://localhost:8000

# URL PÚBLICA do site (frontend) pros links clicáveis que o bot posta no
# Discord (ex.: horário do mass-info, confirmação de regear). Em dev, o
# frontend roda no Vite (porta diferente do backend) — aponte pra lá:
# BOT_PUBLIC_URL=http://localhost:5173
# Sem definir, cai em BOT_SITE_URL (funciona em produção se front e back
# dividem a mesma origem atrás de um proxy reverso).
BOT_PUBLIC_URL=

# Bearer secret compartilhado com o backend (mesmo valor de BOT_API_SECRET
# no backend/.env). Vai em Authorization: Bearer $BOT_API_SECRET nas chamadas /bot/*.
BOT_API_SECRET=

# Servidor e canal privados do Discord oficial onde administradores revisam
# avatars/banners enviados pelos usuários.
PROFILE_MODERATION_GUILD_ID=
PROFILE_MODERATION_CHANNEL_ID=
